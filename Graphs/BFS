/* 
 * Problem: BFS Traversal of Graph
 *
 * Given:
 * - An adjacency list representing a graph
 *
 * Task:
 * - Perform Breadth First Search (BFS)
 * - Start traversal from node 0
 * - Return BFS traversal order
 *
 * -------------------------------------------------------
 * Graph Representation:
 *
 * adj.get(i) → list of neighbors of node i
 *
 * Example:
 *
 * adj = [
 *   [1,2],
 *   [0,3,4],
 *   [0],
 *   [1],
 *   [1]
 * ]
 *
 * Graph:
 *
 *        0
 *       / \
 *      1   2
 *     / \
 *    3   4
 *
 * -------------------------------------------------------
 * Logic:
 *
 * BFS works level-by-level.
 *
 * We use:
 * 1. Queue → for traversal order
 * 2. Visited array → to avoid revisiting nodes
 *
 * Steps:
 *
 * 1. Start from node 0
 * 2. Mark it visited
 * 3. Push into queue
 *
 * 4. Until queue becomes empty:
 *
 *      a) Remove front node
 *      b) Add it to answer
 *      c) Traverse all neighbors
 *      d) If neighbor unvisited:
 *             mark visited
 *             push into queue
 *
 * -------------------------------------------------------
 * Why Queue?
 *
 * Queue follows FIFO:
 *
 * First inserted → First processed
 *
 * This ensures:
 * - Nodes are processed level-by-level
 *
 * -------------------------------------------------------
 * Dry Run:
 *
 * Graph:
 *
 *        0
 *       / \
 *      1   2
 *     / \
 *    3   4
 *
 * Queue = [0]
 * Visited = [true,false,false,false,false]
 *
 * --------------------------------
 * Remove 0
 * Result = [0]
 *
 * Push neighbors 1,2
 *
 * Queue = [1,2]
 *
 * --------------------------------
 * Remove 1
 * Result = [0,1]
 *
 * Push neighbors 3,4
 *
 * Queue = [2,3,4]
 *
 * --------------------------------
 * Remove 2
 * Result = [0,1,2]
 *
 * Queue = [3,4]
 *
 * --------------------------------
 * Remove 3
 * Result = [0,1,2,3]
 *
 * Queue = [4]
 *
 * --------------------------------
 * Remove 4
 * Result = [0,1,2,3,4]
 *
 * Final Answer:
 * [0,1,2,3,4]
 *
 * -------------------------------------------------------
 * Pseudocode:
 *
 * function bfs(adj):
 *
 *      create queue
 *      create visited[]
 *      create answer list
 *
 *      push 0 into queue
 *      visited[0] = true
 *
 *      while queue not empty:
 *
 *          node = queue.remove()
 *
 *          add node into answer
 *
 *          for neighbor in adj[node]:
 *
 *              if neighbor not visited:
 *
 *                  visited[neighbor] = true
 *                  queue.add(neighbor)
 *
 *      return answer
 *
 * -------------------------------------------------------
 * Time Complexity:
 *
 * O(V + E)
 *
 * V = Vertices
 * E = Edges
 *
 * Every node visited once
 * Every edge checked once
 *
 * -------------------------------------------------------
 * Space Complexity:
 *
 * O(V)
 *
 * Queue + Visited Array
 *
 * -------------------------------------------------------
 * Pattern:
 *
 * Graph + BFS + Queue
 *
 * -------------------------------------------------------
 * Code:
 */

class Solution {

    public ArrayList<Integer> bfs(ArrayList<ArrayList<Integer>> adj) {

        ArrayList<Integer> result = new ArrayList<>();

        // Queue for BFS traversal
        Queue<Integer> q = new LinkedList<>();

        // Visited array
        boolean[] visited = new boolean[adj.size()];

        // Start BFS from node 0
        q.offer(0);
        visited[0] = true;

        while (!q.isEmpty()) {

            int node = q.poll();

            result.add(node);

            // Traverse all neighbors
            for (int neighbor : adj.get(node)) {

                // If not visited
                if (!visited[neighbor]) {

                    visited[neighbor] = true;

                    q.offer(neighbor);
                }
            }
        }

        return result;
    }
}
